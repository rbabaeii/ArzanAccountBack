generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  externalId  Int?      @unique
  slug        String    @unique
  title       String
  titleFa     String?
  description String?
  icon        String?   @default("Sparkles")
  orderIndex  Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                  String    @id @default(cuid())
  externalId          Int       @unique
  name                String
  nameFa              String?
  customTitle         String
  description         String?
  persianDescription  String?
  costPriceUsd        Float
  retailPriceUsd      Float
  pricingUnit         String    @default("unit")
  pricePer1000Usd     Float?
  customMarginPercent Float?
  stockCount          Int?
  inStock             Boolean   @default(true)
  isActive            Boolean   @default(false)
  isFeatured          Boolean   @default(false)
  isFlashDeal         Boolean   @default(false)
  minQty              Int?      @default(1)
  maxQty              Int?      @default(1)
  requiresEmail       Boolean   @default(false)
  requiresPassword    Boolean   @default(false)
  requiresLink        Boolean   @default(false)
  requiresComments    Boolean   @default(false)
  requiredInputs      String?
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  rawDetails          String?
  badge               String?
  image               String?
  rating              Float     @default(4.9)
  reviewCount         Int       @default(15)
  salePriceToman      Float?
  discountPercent     Float?
  tags                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Order {
  id                   String    @id @default(cuid())
  orderNumber          String    @unique
  externalOrderId      Int?
  customerEmail        String
  customerPhone        String?
  customerLink         String?
  totalPriceToman      Int
  totalPriceUsd        Float
  status               String    @default("processing")
  deliveredAccounts    String?
  items                String
  paymentGateway       String    @default("zarinpal")
  targetAccountEmail   String?
  targetAccountPassword String?
  deliveryType         String?   @default("link") // link, credentials, account_activation
  accountCredentials   String?
  isHybridOrder        Boolean?  @default(false)
  instantItemsCount    Int?      @default(0)
  activationItemsCount Int?      @default(0)
  refundReason         String?
  refundCardNumber     String?
  refundIban           String?
  refundAmountToman    Int?
  refundReceiptUrl     String?
  refundTrackingCode   String?
  refundMethod         String?   // bank_card | wallet
  refundRejectionReason String?
  refundedAt           DateTime?
  refundedByAdminId    String?
  refundedByAdminName  String?
  approvedByAdminId    String?
  approvedByAdminName  String?
  approvedByAdminPhone String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Coupon {
  id               String   @id @default(cuid())
  code             String   @unique
  discountPercent  Int
  maxDiscountToman Int?
  minOrderToman    Int?
  expiresAt        String?
  usageCount       Int      @default(0)
  maxUsage         Int?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  details    String
  user       String   @default("System")
  adminId    String?
  adminName  String?
  adminPhone String?
  type       String
  createdAt  DateTime @default(now())
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String?   @unique
  phone              String?   @unique
  password           String?
  role               String    @default("USER") // SUPER_ADMIN, CATALOG_MANAGER, FINANCE_ADMIN, SUPPORT_ADMIN, USER
  status             String    @default("ACTIVE") // ACTIVE, BLOCKED, PENDING
  walletBalanceToman Int       @default(0)
  directDepositBalance Int     @default(0) // شارژ مستقیم توسط خود کاربر (تنها مبلغ قابل تسویه)
  cashbackBonusBalance Int     @default(0) // هدیه کش‌بک و پاداش خرید (غیرقابل برداشت نقدی)
  referralCode       String?   @unique   // کد معرف اختصاصی کاربر
  referredByCode     String?             // کد معرف کاربری که این شخص را دعوت کرده
  clubPoints         Int       @default(150)
  nationalCode       String?
  birthDate          String?
  jobTitle           String?
  bankCardsJson      String?   // JSON array of user bank cards
  addressesJson      String?   // JSON array of user addresses
  isTwoFactorEnabled Boolean   @default(false)
  avatar             String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  withdrawals        WithdrawalRequest[]
}

model WithdrawalRequest {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  amountToman          Int
  status               String    @default("PENDING") // PENDING, APPROVED, REJECTED
  cardNumber           String?
  sheba                String?
  bankName             String?
  accountOwnerName     String?
  userNote             String?
  adminNote            String?
  bankTrackingCode     String?
  bankReceiptUrl       String?
  processedByAdminName String?
  processedByAdminId   String?
  processedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model EmailLog {
  id           String   @id @default(cuid())
  to           String
  subject      String
  template     String
  status       String   @default("SENT")
  errorMessage String?
  metadata     String?
  createdAt    DateTime @default(now())
}

model SmsLog {
  id           String   @id @default(cuid())
  to           String
  bodyId       Int?
  text         String
  status       String   @default("SENT") // SENT, FAILED
  recId        String?
  retStatus    Int?
  strRetStatus String?
  errorMessage String?
  metadata     String?
  template     String?
  createdAt    DateTime @default(now())
}

model CardPayment {
  id                  String    @id @default(cuid())
  paymentToken        String    @unique
  orderId             String?
  userId              String?
  orderNumber         String?
  paymentType         String    @default("ORDER") // ORDER | WALLET_TOPUP
  amountToman         Int
  amountRial          Int
  uniqueAmountRial    Int?      // Exact unique Rial amount generated by CartBeCart
  status              String    @default("PENDING") // PENDING | PAID | EXPIRED | MANUAL_REVIEW | APPROVED | REJECTED
  cartBeCartOrderId   String?
  cartBeCartOrderCode String?
  paymentUrl          String?
  destCardNumber      String?
  destCardOwner       String?
  userCardNumber      String?   // Sender card number or last 4 digits
  trackingCode        String?   // Bank reference / transaction tracking code
  receiptUrl          String?   // Uploaded screenshot of the receipt
  depositTime         String?
  userNote            String?
  adminNote           String?
  reviewedByAdminId   String?
  reviewedByAdminName String?
  reviewedAt          DateTime?
  expiresAt           DateTime?
  graceEndsAt         DateTime?
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}



