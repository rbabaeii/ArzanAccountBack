# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection
# SQLite for instant zero-config local development:
DATABASE_URL="file:./dev.db"
# For PostgreSQL container/server:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arzan_account_db?schema=public"

# JWT Authentication
JWT_SECRET=arzan-account-secret-key-2026

# irMarket API Credentials
IRMARKET_BASE_URL=https://api.irmarket.store
IRMARKET_API_KEY=your_irmarket_api_key_here

# Security & Mock Safety Guard (Never charge real wallet in dev/test!)
MOCK_PURCHASE=true

# Initial Currency Rate & Profit Defaults
DEFAULT_USD_TO_RIAL_RATE=720000
DEFAULT_MARGIN_PERCENT=15

# SMTP Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
MAIL_FROM_NAME=ارزان اکانت
MAIL_FROM_EMAIL=noreply@arzanaccount.com
MAIL_REPLY_TO=support@arzanaccount.com
MAIL_ENABLED=true
SITE_PUBLIC_URL=https://arzanaccount.com

# BrsApi Live USD Currency Sync Settings
CURRENCY_API_KEY=your_brsapi_key_here
CURRENCY_SYNC_INTERVAL_MINUTES=15

# CartBeCart Payment Gateway (Automatic Card-to-Card Verification)
CARTBECART_API_KEY=
CARTBECART_ENABLED=true
FALLBACK_CARD_NUMBER=6037998123456789
FALLBACK_CARD_OWNER=رضا بابایی
FALLBACK_BANK_NAME=بانک ملی ایران


